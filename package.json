{
  "name": "lilymap",
  "version": "0.1.0",
  "description": "A local Hugo workspace for the lily-epitaph theme.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "check": "node scripts/check-js.mjs",
    "protocol:check": "node scripts/check-protocol.mjs",
    "test": "node --test",
    "build": "esbuild server.mjs --bundle --platform=node --target=node22 --format=cjs --define:import.meta.url=undefined --outfile=server.cjs",
    "exe": "npm run build && node scripts/build-exe.mjs",
    "release": "node scripts/prepare-release.mjs"
  },
  "pkg": {
    "assets": [
      "public/index.html",
      "public/**/*"
    ]
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.0.0",
    "ajv": "^8.17.1",
    "esbuild": "^0.25.0",
    "rcedit": "^5.0.1"
  },
  "dependencies": {
    "yaml": "2.9.0"
  }
}
